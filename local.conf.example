# local.conf — Machine-specific dotfiles configuration
# This file is gitignored. Copy to local.conf and edit.
# Generated automatically on first install, or manually:
#   cp local.conf.example local.conf

# ========== Git ==========
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL="your@email.com"

# ========== Install mode ==========
# For each dotfile: "link" (symlink) or "append" (inject as marked block)
# "link"   — symlink to dotfiles/ (stays synced with repo)
# "append" — adds content inside # >>> dotfiles >>> markers (preserves existing config)
ZSHRC_MODE="link"       # link | append
BASHRC_MODE="append"    # link | append
VIMRC_MODE="link"       # link | append
TMUX_MODE="link"        # link | append
P10K_MODE="link"        # link | append
# gitconfig: managed via `git config --global` (no link/append needed)
