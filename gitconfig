[user]
	name = liveseongho
	email = liveseongho@gmail.com

[core]
	editor = vim
	autocrlf = input
	pager = less -FRX

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[alias]
	st = status -sb
	co = checkout
	br = branch
	ci = commit
	lg = log --oneline --graph --decorate -20
	unstage = reset HEAD --
	last = log -1 HEAD

[color]
	ui = auto
