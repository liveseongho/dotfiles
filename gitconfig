[user]
	name = liveseongho
	email = liveseongho@gmail.com

[core]
	editor = vim
	autocrlf = input
	pager = less -FRX
	quotepath = false

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[alias]
	st = status -sb
	co = checkout
	br = branch
	ci = commit
	lg = log --oneline --graph --decorate -20
	unstage = reset HEAD --
	last = log -1 HEAD
	amend = commit --amend -v
	wdiff = diff --color-words

[diff]
	algorithm = patience
	noprefix = true
	renames = copies

[merge]
	conflictstyle = diff3

[branch]
	autosetuprebase = always

[color]
	ui = auto
